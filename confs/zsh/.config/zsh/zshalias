# alias reason='aider --api-key openai=`op.exe read op://Prescrypto/OpenAI\ Token/key` --model o3-mini --reasoning-effort high'

# Windows Subsystem for Linux (WSL) aliases
alias nuget="mono /usr/local/bin/nuget.exe"
alias op='op.exe'
