# Disable globbing with git
alias git='noglob git'

# Replace cat with bat
alias cat='batcat --theme="Catppuccin-${CATPPUCCIN_FLAVOR}"'

# Tmux attach alias
alias ta='tmux attach -t'

# Clear the screen
alias c='clear'

# Ranger file explorer
alias r='ranger'

# Text search in file content
alias rg='rgi'
alias ag='rgi'

# HTTPie for HTTP requests
alias http='http --style vim'

# Replace ls with eza (a modern replacement for ls)
alias ls='eza --hyperlink'

# Replace cd with z (a smarter cd command)
alias cd='z'

# Git aliases
alias g='git'
alias gl="gli"
alias gcp='git cherry-pick'
alias gs='git s'
alias gb='git b'
alias gbc='git bc'
alias gc='git c'
alias gca='git ca'
alias gcm='git cm'
alias ga='git a'
alias gp='git p'
alias gpf='git pf'
alias gd='git d'
alias gdt='git dt'
alias gm='git m'
alias gmt='git mt'
alias gf='git f'
alias gfm='git fm'
alias gr='git r'
alias gco='git co'


# Debug colors in tmux
alias colors='( x=`tput op` y=`printf %$((${COLUMNS}-6))s`;for i in {0..256};do o=00$i;echo -e ${o:${#o}-3:3} `tput setaf $i;tput setab $i`${y// /=}$x;done; )'

# Docker
alias docker_clean_images='docker rmi $(docker images -a --filter=dangling=true -q)'
alias docker_clean_ps='docker rm $(docker ps --filter=status=exited --filter=status=created -q)'

# Aider (AI assistant)
alias ai='aider --api-key gemini=`op read op://Odasoft/Gemini\ API\ Key/credential` --model gemini-2.5-pro --vim'
